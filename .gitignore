raw-data/
Company Archive/
Topic Archive/
memory/
out/
logs/
lancedb/
research/
MEMORY.md

# ---- Local environments ------------------------------------------------------
.venv/
.venv-ui/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# ---- OS / editor -------------------------------------------------------------
.DS_Store
Thumbs.db
