# =============================================================================
#  READ THIS BEFORE `git init`
#
#  Everything below contains either SECRETS or REAL PORTFOLIO DATA.
#  Git keeps history: once a file is committed, deleting it later does NOT
#  remove it from the repository. The order matters —
#
#      1. write this file      2. git init      3. git add .
#
#  If you have already committed any of these, do not just delete them.
#  Rotate the Telegram token and start a fresh repository.
# =============================================================================

# ---- Secrets -----------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.*

# ---- Real data: positions, thesis ledger, sizing lineage ---------------------
*.db
*.db-journal
*.db.bak*
cio.db
cfo.db

