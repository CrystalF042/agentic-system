# 复制成 .env 并填好（.env 不要提交/外传）。
# ============ Telegram（早报/专题推送）============
TELEGRAM_BOT_TOKEN=在BotFather拿到的token
TELEGRAM_CHAT_ID=你的数字用户ID
# 自测时不真发，只打印：置 1
CIO_TG_DRYRUN=0

# ============ Ollama 本地推理（严禁云端/中国模型）============
OLLAMA_HOST=http://127.0.0.1:11434
CIO_MODEL_BRIEF=gpt-oss:20b
CIO_MODEL_LIGHT=phi4-mini
CIO_MODEL_EMBED=nomic-embed-text-v2-moe
# 离线自测（不调 Ollama）：置 1
CIO_MOCK_LLM=0

# ============ 早报参数 ============
CIO_NEWS_PER_REGION=5
CIO_TREND_MAX=12

# ============ SEC EDGAR（美股专题公告，需带 UA）============
SEC_USER_AGENT=CIO-Agent research your_email@example.com
