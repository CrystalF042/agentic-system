# Copy this file to `.env` and fill it in.
#
#   cp .env.example .env
#
# `.env` is in .gitignore and MUST NEVER be committed or shared.
# It holds real credentials. `scripts/git_preflight.py` checks this before
# every push — run it, don't trust your memory.

# =============================================================================
#  Market
# =============================================================================
# us = US equities (this is what the system is built for)
CIO_MARKET=us

# =============================================================================
#  Debate engine  —  which model runs Bull / Bear / Judge
# =============================================================================
# Leave CIO_DEBATE_ENGINE unset  ->  local Ollama (gpt-oss:20b), free, offline.
# Set it to Claude               ->  better reasoning, costs money, and the
#                                    research material leaves this machine.
#
# What leaves the machine on the Claude path: public news headlines + up to
# 400 chars of body, SEC filings, the public price/fundamentals panel, and the
# ticker. What never leaves: positions, NAV, thesis ledger, book, review ledger.
#
# CIO_DEBATE_ENGINE=claude:claude-sonnet-5
# CIO_ANTHROPIC_API_KEY=sk-ant-...

# Hard daily spend cap in USD for the debate engine. 0 = no cap.
# The per-run count cap (5 names/day) does NOT limit money: one name with a lot
# of material can burn ten times the tokens of another.
CIO_MAX_USD_PER_DAY=5

# Turn the automatic research pipeline off without uninstalling anything.
# Being off shows up in the heartbeat — a switched-off pipeline and a broken
# pipeline are not allowed to look the same.
CIO_RESEARCH_ENABLED=1

# =============================================================================
#  Local models (Ollama)  —  used when CIO_DEBATE_ENGINE is unset
# =============================================================================
OLLAMA_HOST=http://127.0.0.1:11434
CIO_MODEL_BRIEF=gpt-oss:20b
CIO_MODEL_LIGHT=phi4-mini
CIO_MODEL_EMBED=nomic-embed-text-v2-moe

# Offline development: 1 = never call any model, return a stub.
# Set this to 1 while writing code so you never wait on (or pay for) a model.
CIO_MOCK_LLM=0

# =============================================================================
#  Telegram  —  where "N proposals awaiting your approval" is delivered
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Second bot, for the interactive console (run_tgbot.py).
# Telegram delivers each update to exactly ONE getUpdates consumer, so if two
# programs poll with the same token, commands are randomly lost — silently.
# Leave empty and it falls back to TELEGRAM_BOT_TOKEN with a loud warning.
CIO_CTRL_BOT_TOKEN=

# 1 = print messages instead of sending them. ALWAYS 1 on a dev machine.
CIO_TG_DRYRUN=1

# =============================================================================
#  Development safety
# =============================================================================
# Point the database somewhere throwaway so you never touch a real ledger.
# Leave this UNSET on the production machine.
# CIO_DB=/tmp/dev.db

# Synthetic prices, no network. Useful for offline smoke tests.
# CIO_QUANT_MOCK=1

# =============================================================================
#  SEC EDGAR
# =============================================================================
# SEC requires a real contact address in the User-Agent or it will rate-limit
# you. Put a real email here.
SEC_USER_AGENT=CIO-Agent research your_email@example.com
